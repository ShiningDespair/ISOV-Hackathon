# ---------------------------------------------------------------------
# ISOV-Hackathon — backend ortam degiskenleri
# Bu dosyayi `.env` olarak kopyalayip degerleri doldurun.
# ---------------------------------------------------------------------

# Calisma modu: development | production
# production'da hata yanitlarinda stack trace GIZLENIR.
NODE_ENV=development

# API'nin dinleyecegi port. CONTRACT.md: backend 5005.
PORT=5005

# --- MySQL 8 baglanti bilgileri --------------------------------------
# Docker compose icinde servis adi (or. isov-mysql), disaridan 127.0.0.1
DB_HOST=isov-mysql
# Container ici port 3306, host uzerinden 3312 map'li
DB_PORT=3306
DB_USER=isov
DB_PASSWORD=degistir-beni
DB_NAME=isov

# --- CORS -------------------------------------------------------------
# Virgulle ayrilmis izinli origin listesi. Bos birakilirsa hepsine izin verilir.
CORS_ORIGIN=http://localhost:3005,https://hackathon.dhsyazilim.com

# --- Anthropic (opsiyonel) -------------------------------------------
# YOKSA sistem calismaya devam eder: ozetleme deterministik heuristige duser.
# Demo anahtarsiz da tam calisir.
ANTHROPIC_API_KEY=
# Model kimligi — degistirmeyin.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Tekillestirme esikleri (opsiyonel, ince ayar) --------------------
# Simhash hamming mesafesi esigi (dusuk = daha kati kumeleme)
DEDUP_HAMMING_THRESHOLD=12
# Baslik jaccard benzerlik esigi
DEDUP_JACCARD_THRESHOLD=0.35

# --- Seed --------------------------------------------------------------
# Toplayici ajanlarin yazdigi JSON dosyalarinin bulundugu klasor
SEED_DIR=/srv/projects/hackathon/seed
