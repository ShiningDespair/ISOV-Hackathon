# ---------------------------------------------------------------------
# ISOV-Hackathon — backend ortam degiskenleri
# Bu dosyayi `.env` olarak kopyalayip degerleri doldurun.
# ---------------------------------------------------------------------

# Calisma modu: development | production
# production'da hata yanitlarinda stack trace GIZLENIR.
NODE_ENV=development

# API'nin dinleyecegi port. CONTRACT.md: backend 5005.
PORT=5005

# --- MySQL 8 baglanti bilgileri --------------------------------------
# docker-compose icinde servis adi: db  — host makineden: 127.0.0.1 + port 3312
DB_HOST=db
# Container ici port 3306, host uzerinden 3312 map'li
DB_PORT=3306
DB_USER=isov
# docker-compose varsayilani ile ayni; uretimde mutlaka degistirin.
DB_PASSWORD=isov_pass
DB_NAME=isov

# --- CORS -------------------------------------------------------------
# Virgulle ayrilmis izinli origin listesi. Bos birakilirsa hepsine izin verilir.
CORS_ORIGIN=http://localhost:3005,https://hackathon.dhsyazilim.com

# --- Anthropic (opsiyonel) -------------------------------------------
# YOKSA sistem calismaya devam eder: ozetleme deterministik heuristige duser.
# Demo anahtarsiz da tam calisir.
ANTHROPIC_API_KEY=
# Model kimligi — degistirmeyin.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Tekillestirme esikleri (opsiyonel, ince ayar) --------------------
# Simhash hamming mesafesi esigi (dusuk = daha kati kumeleme)
DEDUP_HAMMING_THRESHOLD=12
# Baslik jaccard benzerlik esigi (taban sart)
DEDUP_JACCARD_THRESHOLD=0.35
# Govde neredeyse ayniysa simhash'e bakilmadan birlestir
DEDUP_BODY_JACCARD_THRESHOLD=0.5
# Baslik ortusmesi bu kadar gucluyse hamming esigi gevsetilir
# (yalnizca FARKLI kaynaklar arasinda uygulanir)
DEDUP_STRONG_TITLE_JACCARD=0.45
DEDUP_RELAXED_HAMMING=26

# --- Semantik (diller arasi) tekillestirme — EK KATMAN ----------------
# Sozcuksel dedup'in (simhash + jaccard) USTUNE calisir, onu DEGISTIRMEZ.
# Model yoksa ya da Qdrant erisilemezse sistem eskisi gibi calisir,
# sadece semantik kumeler olusmaz.
SEMANTIC_DEDUP_ENABLED=true
# Kosinus benzerligi esigi. 131 haberlik canli veri uzerinde kalibre edildi:
# 0.935 -> bilinen 18 dogru cift yakalandi, sifir yanlis pozitif.
# Yukseltmek kume sayisini azaltir; 0.93 altina inmek yanlis pozitif uretir
# (or. "Fransa'da sanayi uretimi" <-> "Italya'da sanayi uretimi" = 0.9303).
SEMANTIC_SIMILARITY_THRESHOLD=0.935
# Iki haber en fazla kac gun arayla yayimlanmissa ayni olay sayilir.
SEMANTIC_MAX_DAY_GAP=4
# Sayisal uyum siniri: iki metinde de rakam varsa en az biri ortusmeli.
# (Ayni olay ayni manset rakamlarini tasir; kapatirsaniz yanlis pozitif artar.)
SEMANTIC_REQUIRE_NUMERIC_AGREEMENT=true

# --- Embedding modeli (yerel, CPU, API ANAHTARI YOK) -------------------
# HuggingFace'ten ilk kosumda indirilir, backend/.cache/models altinda saklanir.
# Alternatif: Xenova/multilingual-e5-small (384 boyut, daha hafif ama daha zayif
# ayrim) veya Xenova/paraphrase-multilingual-MiniLM-L12-v2.
# DIKKAT: model degisirse yukaridaki esik YENIDEN KALIBRE EDILMELIDIR.
EMBEDDING_MODEL=Xenova/multilingual-e5-base
# Model onbellek klasoru (bos birakilirsa backend/.cache/models).
EMBEDDING_CACHE_DIR=
# Model yukleme/indirme ust siniri (ms). Ag yavassa seeder sonsuza kadar beklemesin.
EMBEDDING_LOAD_TIMEOUT_MS=300000

# --- Qdrant vektor deposu ---------------------------------------------
# docker-compose icinde: http://qdrant:6333 — host makineden: http://127.0.0.1:6335
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=isov_articles
QDRANT_TIMEOUT_MS=8000

# --- Haber gorseli toplama (og:image) ---------------------------------
# Toplu isin tek kosumda deneyecegi haber sayisi (`npm run images`).
# HTTP ucu (POST /api/articles/fetch-images) icin ust sinir 100'dur.
IMAGE_FETCH_LIMIT=200
# GENEL es zamanlilik siniri. Nazik olmak icin dusuk tutuluyor.
IMAGE_FETCH_CONCURRENCY=6
# AYNI host'a saniyede en fazla kac istek. Tek host'ta yigilan kaynaklarda
# (or. Resmî Gazete) bu sinir olmadan onlarca istek ayni saniyede gider.
IMAGE_HOST_RATE_PER_SEC=2
# Istek zaman asimi (ms). Yavas kaynak tum toplu isi kilitlemesin.
IMAGE_FETCH_TIMEOUT_MS=8000
# Sayfanin okunacak ilk bayt miktari. <head> yeterli; gerisi indirilmez.
IMAGE_MAX_HTML_BYTES=262144
# User-Agent. Bos birakilirsa ISOV-HaberBot kimligi kullanilir.
IMAGE_USER_AGENT=

# --- Seed --------------------------------------------------------------
# Toplayici ajanlarin yazdigi JSON dosyalarinin bulundugu klasor
SEED_DIR=/srv/projects/hackathon/seed

# --- KIMLIK DOGRULAMA ve OTURUM ---------------------------------------
# Oturum cerezi: isov_session (httpOnly, sameSite=Lax, path=/).
# `secure` bayragi YALNIZCA NODE_ENV=production iken eklenir; aksi halde
# http://localhost uzerinden cerez hic gonderilmez ve oturum sessizce
# calismaz.
#
# Cerez ve DB kaydinin omru (saat). Varsayilan 168 = 7 gun.
SESSION_TTL_HOURS=168

# Sifre sifirlama baglantisinin omru (saat, ust sinir 72).
PASSWORD_RESET_TTL_HOURS=2

# Not: sifre ozeti node:crypto scrypt ile uretilir (scrypt$N$r$p$salt$hash).
# Anahtar ya da "pepper" ortam degiskeni YOK: her ozet kendi tuzunu ve
# maliyet parametrelerini tasir, boylece ortam degiskeni kaybolunca
# kullanicilar girisi kaybetmez.
#
# Hiz siniri bellek-icidir (tek konteyner) — ayar gerektirmez:
#   /auth/login, /auth/register        : 15 dakikada 10 deneme (IP bazli)
#   /auth/password/reset-request       : 15 dakikada 5 deneme  (IP bazli)
# E-posta bazli kalici kilit: 5 hatali denemede 15 dakika (users tablosunda).

# --- ADMIN TOHUMLAMA (`npm run migrate`) ------------------------------
# IKISI BIRLIKTE tanimliysa admin kullanici olusturulur/guncellenir:
#   role='admin', status='aktif', must_change_password=1
# Sifre ASLA loglanmaz. Politika: en az 10 karakter, en az bir harf ve
# bir rakam. Tanimli degilse adim atlanir ve cikti bunu soyler.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Adminin baglanacagi kurum (tenants.tenant_key). Varsayilan: isov
ADMIN_TENANT_KEY=isov
# Gorunen ad (opsiyonel).
ADMIN_FULL_NAME=

# --- SUNUCU TARAFI PDF (Chromium / puppeteer-core) --------------------
# Imajda sistem Chromium'u kurulu (backend/Dockerfile: apt chromium +
# fonts-liberation + fonts-dejavu-core). Host makinede gelistirirken
# Chromium yoksa PDF ucu 503 doner, geri kalan her sey calisir.
#
# Chromium ikilisinin yolu. Bos birakilirsa su siralama denenir:
# /usr/bin/chromium, /usr/bin/chromium-browser, /usr/bin/google-chrome-stable
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# puppeteer-core hic indirmez; tam `puppeteer` paketine gecilirse gerekli.
PUPPETEER_SKIP_DOWNLOAD=1
# false -> PDF uretimi TAMAMEN devre disi (isAvailable() false, uc 503).
# Bozulma yolunu test etmek icin de bu kullanilir.
PDF_ENABLED=true
# Tarayici ornegi yeniden kullanilir; bu sure bosta kalirsa kapatilir (ms).
PDF_IDLE_TIMEOUT_MS=300000
# Tek PDF uretimi icin ust sinir (ms).
PDF_RENDER_TIMEOUT_MS=45000

# --- SMTP / E-POSTA ---------------------------------------------------
# AYAR KAYNAGI SIRASI:
#   1) app_settings.smtp  (admin panelinden; sifre AES-256-GCM, SETTINGS_SECRET
#                          tanimli olmak ZORUNDA, yoksa sifre cozulemez)
#   2) SMTP_URL
#   3) SMTP_HOST + SMTP_PORT + SMTP_USER + SMTP_PASSWORD
# Hicbiri yoksa mailService `available:false` doner; sendMail istisna
# FIRLATMAZ, email_log'a status='hata' yazar ve sistem calismaya devam eder.
#
# false -> gonderim tamamen kapali (test/demo icin).
MAIL_ENABLED=true
# Tek satirda tam URL — or. smtps://kullanici:sifre@mail.ornek.com:465
SMTP_URL=
# Ya da alan alan:
SMTP_HOST=
SMTP_PORT=587
# 465 icin true (ortuk TLS); 587 icin false (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Gonderen adresi — "İSOV Bülten <bulten@ornek.com>" bicimi de kabul edilir.
SMTP_FROM=
# Baglanti zaman asimlari (ms). Bozuk SMTP bulten isini asili birakmasin.
SMTP_CONNECT_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
# HIZ SINIRI: ayni aliciya dakikada azami e-posta. Hem bellek-ici pencere
# hem email_log sorgusu ile uygulanir.
MAIL_RATE_PER_MINUTE=5
# E-postadaki haber baglantilarinin tabani (bos ise haberin kendi URL'si).
PUBLIC_BASE_URL=https://hackathon.dhsyazilim.com

# --- BULTEN ve ZAMANLAYICI --------------------------------------------
# VARSAYILAN KAPALI. Demo sirasinda istenmeyen gonderim olmasin diye
# zamanlayici acikca 'true' yapilmadan kosmaz; `npm run scheduler` kapali
# durumda neden kosmadigini yazip 0 ile cikar.
#   Acmak: DIGEST_SCHEDULER_ENABLED=true npm run scheduler
DIGEST_SCHEDULER_ENABLED=false
# Zamanlayici kontrol araligi (ms). En kucuk zamanlama birimi saat oldugu
# icin dakikada bir kontrol yeterli. Cron/node-cron EKLENMEDI.
DIGEST_TICK_MS=60000
# Toplu gonderimde es zamanli kullanici sayisi (fetch-images deseni).
DIGEST_CONCURRENCY=3
# Bultene gorsel PDF eki eklensin mi. Kullanici tercihi `format='tam'` ise
# zaten eklenir; 'true' herkese ekler, 'false' hic eklemez.
DIGEST_ATTACH_PDF=true
