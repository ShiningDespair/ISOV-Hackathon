# --- Veritabani ---
DB_ROOT_PASSWORD=isov_root
DB_NAME=isov
DB_USER=isov
DB_PASSWORD=isov_pass
DB_PORT=3312

# --- Servis portlari (host tarafi) ---
BACKEND_PORT=5005
FRONTEND_PORT=3005
QDRANT_PORT=6335

# --- LLM ---
# Bos birakilabilir. Anahtar yoksa ozetleme deterministik heuristik
# fallback ile calisir; demo anahtarsiz da ayaga kalkar.
ANTHROPIC_API_KEY=

# --- Semantik tekillestirme (diller arasi) ---
# Kapatilirsa sistem yalnizca sozcuksel kumeleme yapar; hata vermez,
# sadece farkli dillerdeki ayni olaylar ayri kalir.
SEMANTIC_DEDUP_ENABLED=true
# 0,935 = yanlis pozitifi sifirlayan en dusuk esik (131 haberlik korpusta
# olculdu). Yukseltmek daha temiz ama daha az kume verir.
SEMANTIC_SIMILARITY_THRESHOLD=0.935
SEMANTIC_MAX_DAY_GAP=4
SEMANTIC_REQUIRE_NUMERIC_AGREEMENT=true

# --- Yonetim ayarlari sifreleme anahtari ---
# `openssl rand -hex 32` ile uretilir. app_settings tablosundaki sirlari
# (SMTP sifresi) AES-256-GCM ile sifreler. TANIMSIZSA sifre kaydedilmez -
# sessizce duz metin yazmak yerine islem reddedilir.
SETTINGS_SECRET=
